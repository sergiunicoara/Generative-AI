# Copy to .env and fill in. Every key here is read by graphrag/core/config.py.
#
# This file used to describe a Gemini-only deployment and omitted every key the
# platform actually needs — copying it produced an unconfigurable app. It also
# used TIMESCALE_URL where the rest of the repo uses TIMESCALE_DB_URL.

# ── LLM providers ──────────────────────────────────────────────────────────────
# Groq is primary for get_llm() (large/synthesis calls) as of 2026-08-17 —
# free tier (200K TPD for gpt-oss-120b), falls over to DeepSeek on
# rate-limit/timeout. Set LLM_INGEST_PROVIDER=deepseek to skip Groq entirely,
# or LLM_INGEST_PROVIDER=cerebras to opt into the Cerebras chain below
# (only worthwhile if that account is funded — check its billing dashboard).
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# Groq is primary for both get_llm() (above) and get_fast_llm()
# (routing/agentic reasoning steps — see ADR 0006).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# DeepSeek is the fallback when Groq rate-limits (fail-fast, no sleep), and is
# Groq's own fallback for get_fast_llm(). Uses deepseek-v4-flash (cheaper
# tier, ~3x less than v4-pro) — see DeepSeekLLM._DEFAULT_MODEL in
# graphrag/core/llm_client.py.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter is an optional third fallback hop behind DeepSeek, using its
# free ":free" model tier (20 req/min, 50 req/day, no card required). Get a
# key at https://openrouter.ai (Keys page). Leave unset if you don't have
# one — get_llm()'s chain collapses to plain Groq -> DeepSeek without it.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# OpenAI supplies embeddings only — 3072d, matching the vector index dimension
# declared in graphrag/graph/schema.cypher.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-large

# Gemini is legacy and no longer on the default path. Leave unset unless you
# explicitly set LLM_INGEST_PROVIDER=gemini.
# GOOGLE_API_KEY=
# GEMINI_INGEST_MODEL=gemini-2.0-flash
# GEMINI_QUERY_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# LLM_INGEST_PROVIDER=

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_dev

# ── Redis (result store, query cache, alias registry, session context) ─────────
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://graphrag:graphrag_dev@localhost:5672/

# ── TimescaleDB (KPI store) ────────────────────────────────────────────────────
# Note the name: TIMESCALE_DB_URL, not TIMESCALE_URL.
TIMESCALE_DB_URL=postgresql+asyncpg://graphrag:graphrag_dev@localhost:5432/graphrag_kpis
KPI_BACKEND=sqlite

# ── Auth ───────────────────────────────────────────────────────────────────────
# Required in any environment that is not in DEV_ENVS (graphrag/core/config.py).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
# Must differ from JWT_SECRET_KEY so cookie signing can be rotated separately.
SESSION_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CORS_ORIGINS=["http://localhost:8000","http://localhost:8050"]

# Tenant stamped into every JWT issued by the browser and dev login flows.
# Requests are scoped to the tenant in their token, never to one supplied in
# the request body — set this to the tenant your data was ingested under.
DEFAULT_TENANT=default

# ── Rate limiting ──────────────────────────────────────────────────────────────
GRAPHRAG_RATE_LIMIT_INGEST=20/minute
GRAPHRAG_RATE_LIMIT_QUERY=60/minute
GRAPHRAG_RATE_LIMIT_AUTH=10/minute
# Number of trusted reverse-proxy hops in front of the app. Leave 0 when the
# app is directly exposed; X-Forwarded-For is only honoured when this is > 0.
GRAPHRAG_TRUSTED_PROXIES=0

# ── Admin dashboard (graphrag/dashboard/app.py) ───────────────────────────────
# GRAPHRAG_ADMIN_TOKEN gates /admin; required in production.
# GRAPHRAG_ADMIN_SECRET signs Dash sessions — set it explicitly, otherwise a
# fresh random key is generated per process, breaking sessions across replicas.
GRAPHRAG_ADMIN_TOKEN=
GRAPHRAG_ADMIN_SECRET=

# ── Misc ───────────────────────────────────────────────────────────────────────
GRAPHRAG_RDF_EXPORT_PATH=exports/graph_export.ttl
WIKIDATA_LINKING_ENABLED=false
LLM_CACHE_ENABLED=false
LOG_LEVEL=INFO
ENV=development
