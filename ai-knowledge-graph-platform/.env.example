# Copy to .env and fill in. Every key here is read by graphrag/core/config.py.
#
# This file used to describe a Gemini-only deployment and omitted every key the
# platform actually needs — copying it produced an unconfigurable app. It also
# used TIMESCALE_URL where the rest of the repo uses TIMESCALE_DB_URL.

# ── LLM providers ──────────────────────────────────────────────────────────────
# Groq is primary for get_llm() (large/synthesis calls) as of 2026-08-17 —
# free tier (200K TPD for gpt-oss-120b), falls over to DeepSeek on
# rate-limit/timeout. Set LLM_INGEST_PROVIDER=deepseek to skip Groq entirely,
# or LLM_INGEST_PROVIDER=cerebras to opt into the Cerebras chain below
# (only worthwhile if that account is funded — check its billing dashboard).
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# Groq is primary for both get_llm() (above) and get_fast_llm()
# (routing/agentic reasoning steps — see ADR 0006).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# DeepSeek is the fallback when Groq rate-limits (fail-fast, no sleep), and is
# Groq's own fallback for get_fast_llm(). Uses deepseek-v4-flash (cheaper
# tier, ~3x less than v4-pro) — see DeepSeekLLM._DEFAULT_MODEL in
# graphrag/core/llm_client.py.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter is an optional third fallback hop behind DeepSeek, using its
# free ":free" model tier (20 req/min, 50 req/day, no card required). Get a
# key at https://openrouter.ai (Keys page). Leave unset if you don't have
# one — get_llm()'s chain collapses to plain Groq -> DeepSeek without it.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# OpenAI supplies embeddings only — 3072d, matching the vector index dimension
# declared in graphrag/graph/schema.cypher.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-large

# Gemini is legacy and no longer on the default path. Leave unset unless you
# explicitly set LLM_INGEST_PROVIDER=gemini.
# GOOGLE_API_KEY=
# GEMINI_INGEST_MODEL=gemini-2.0-flash
# GEMINI_QUERY_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# LLM_INGEST_PROVIDER=

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_dev

# ── Redis (result store, query cache, alias registry, session context) ─────────
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://graphrag:graphrag_dev@localhost:5672/

# Prometheus uses this dedicated Bearer token to scrape the protected /metrics
# endpoint. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROMETHEUS_METRICS_TOKEN=replace_with_a_random_metrics_token

# ── TimescaleDB (KPI store) ────────────────────────────────────────────────────
# Note the name: TIMESCALE_DB_URL, not TIMESCALE_URL.
TIMESCALE_DB_URL=postgresql+asyncpg://graphrag:graphrag_dev@localhost:5432/graphrag_kpis
KPI_BACKEND=sqlite

# ── Auth ───────────────────────────────────────────────────────────────────────
# Required in any environment that is not in DEV_ENVS (graphrag/core/config.py).
# Must be at least 32 bytes — RFC 7518 Section 3.2 requires an HMAC-SHA256 key
# no shorter than the hash output, and startup validation now enforces it
# outside DEV_ENVS rather than leaving it to a PyJWT runtime warning.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-at-least-32-bytes
# Must differ from JWT_SECRET_KEY so cookie signing can be rotated separately.
SESSION_SECRET_KEY=

# ── JWT signing algorithm and key rotation (ADR 0011) ─────────────────────────
# HS256 (default) signs with JWT_SECRET_KEY. Rotating it invalidates every
# outstanding token at once, and anything that can verify a token can also mint
# one -- acceptable only while this process is both issuer and sole verifier.
#
# RS256 signs with a private key and publishes the public half at
# /.well-known/jwks.json, so a gateway or auditor can verify without being able
# to mint, and a rotation has an overlap window instead of an outage.
JWT_ALGORITHM=HS256
# Only set while migrating between algorithms, e.g. "HS256,RS256". Narrow it
# again once every token signed with the old algorithm has expired. Read from
# config and NEVER from the token header -- that ordering is the whole defence
# against `alg` confusion.
JWT_ACCEPTED_ALGORITHMS=
# PKCS#8 PEM of the active RS256 signing key. Required when JWT_ALGORITHM=RS256
# outside DEV_ENVS; development generates an ephemeral key if unset.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
JWT_PRIVATE_KEY_PEM=
# Public PEMs of keys that must still VERIFY but no longer sign -- i.e. the
# previous key during a rotation. Newline- or comma-separated. The active key's
# public half is added automatically; this is only for retiring ones.
JWT_PUBLIC_KEYS_PEM=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CORS_ORIGINS=["http://localhost:8000","http://localhost:8050"]

# Tenant stamped into every JWT issued by the browser and dev login flows.
# Requests are scoped to the tenant in their token, never to one supplied in
# the request body — set this to the tenant your data was ingested under.
DEFAULT_TENANT=default

# ── Rate limiting ──────────────────────────────────────────────────────────────
GRAPHRAG_RATE_LIMIT_INGEST=20/minute
GRAPHRAG_RATE_LIMIT_QUERY=60/minute
GRAPHRAG_RATE_LIMIT_AUTH=10/minute
# Number of trusted reverse-proxy hops in front of the app. Leave 0 when the
# app is directly exposed; X-Forwarded-For is only honoured when this is > 0.
GRAPHRAG_TRUSTED_PROXIES=0
# Maximum API request body buffered before FastAPI parsing (10 MiB default).
API_MAX_REQUEST_BYTES=10485760
# Rate-limit counters are shared across replicas when REDIS_URL is set (above).
# Without it each replica counts independently and the effective limit is
# silently multiplied by the replica count. Per-tenant quotas -- a different
# control, see config/settings.yml `quotas:` -- use the same Redis.

# ── Remote MCP transport ──────────────────────────────────────────────────────
# Local execution binds to loopback by default. Containers set 0.0.0.0 in
# their deployment definitions. Browser clients must use one of these exact
# comma-separated origins; non-browser MCP clients normally omit Origin.
GRAPHRAG_MCP_HOST=127.0.0.1
GRAPHRAG_MCP_ALLOWED_ORIGINS=
GRAPHRAG_MCP_MAX_REQUEST_BYTES=1048576

# ── OAuth resource identifiers (RFC 8707 / RFC 9728) ──────────────────────────
# Canonical absolute URIs naming each resource server. Tokens carry the one
# they were minted for in `aud`, and each server rejects tokens minted for the
# other, so an API token cannot reach the governed MCP tool surface. Set these
# to the deployment's real public URLs: they are what a token request's
# `resource` parameter must match and what the /.well-known/
# oauth-protected-resource document advertises. No trailing slash, no query,
# no fragment.
GRAPHRAG_API_RESOURCE=http://localhost:8000
GRAPHRAG_MCP_RESOURCE=http://localhost:8002/mcp
# Comma-separated issuers a client may obtain an MCP-audience token from.
# Defaults to GRAPHRAG_API_RESOURCE, which is this deployment's own
# /auth/token endpoint. Point at an external IdP when one is federated in.
GRAPHRAG_MCP_AUTHORIZATION_SERVERS=

# ── Admin dashboard (graphrag/dashboard/app.py) ───────────────────────────────
# GRAPHRAG_ADMIN_TOKEN gates /admin; required in production.
# GRAPHRAG_ADMIN_SECRET signs Dash sessions — set it explicitly, otherwise a
# fresh random key is generated per process, breaking sessions across replicas.
GRAPHRAG_ADMIN_TOKEN=
GRAPHRAG_ADMIN_SECRET=

# Dashboard → API client (graphrag/dashboard/utils.py)
GRAPHRAG_API_URL=http://localhost:8000
GRAPHRAG_API_TOKEN=
# Serve the dashboard from bundled demo data instead of the live API
GRAPHRAG_DASHBOARD_DEMO=false

# ── Remote SPARQL store (optional; unset = local per-tenant Turtle snapshot) ────
# Use a {tenant} placeholder for per-tenant namespaces, e.g.
#   http://blazegraph:8080/bigdata/namespace/{tenant}_kb/sparql
# A placeholder-free endpoint is a single shared store and serves ONLY the
# tenant named in GRAPHRAG_SPARQL_TENANT; every other tenant gets 403.
GRAPHRAG_SPARQL_ENDPOINT=
GRAPHRAG_SPARQL_TENANT=
# "user:password" basic auth for the store
GRAPHRAG_SPARQL_AUTH=
GRAPHRAG_SPARQL_VENDOR=
# Per-tenant exports are read from <dir>/<tenant>/graph_export.ttl
GRAPHRAG_RDF_EXPORT_DIR=exports

# ── Gremlin backend (optional; ADR 0012) ───────────────────────────────────────
GREMLIN_URL=
GREMLIN_USERNAME=
GREMLIN_PASSWORD=

# ── Workers / results ──────────────────────────────────────────────────────────
# /ready + /health port for a worker process (compose sets one per worker)
WORKER_HEALTH_PORT=8083
# How long a finished query result stays pollable (legacy name: GRAPHRAG_RESULT_TTL)
QUERY_RESULT_TTL_SECONDS=3600
# Per-client rate limits (slowapi syntax)
GRAPHRAG_RATE_LIMIT_SEARCH=60/minute
GRAPHRAG_RATE_LIMIT_CONVERSATION=20/minute

# ── KPI / evaluation ───────────────────────────────────────────────────────────
KPI_DB_PATH=results/kpi_snapshots/kpis.db
GNN_CALIBRATION_EVAL_SET=
RERANKER_MODEL_PATH=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Observability ──────────────────────────────────────────────────────────────
# Tracing is enabled only when this is set
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Energy demo (optional) ─────────────────────────────────────────────────────
# Async SQLAlchemy URL; unset = artifacts/energy/governance.sqlite
ENERGY_GOVERNANCE_DB_URL=
ENERGY_DEMO_INCLUDE_INVALID_FIXTURE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
# Default tenant for the /demo routes (fallback: automotive) and the admin
# dashboard's tenant picker (fallback: aerospace). Unset keeps both fallbacks.
# GRAPHRAG_DEFAULT_TENANT=
WIKIDATA_LINKING_ENABLED=false
LLM_CACHE_ENABLED=false
LOG_LEVEL=INFO
ENV=development
