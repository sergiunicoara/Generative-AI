# Sample/eval data — not tracked; add real samples per project
eval_data/*.json
eval_data/*.jsonl
eval_data/*.npy

# Diagnostic and scratch output. Five of these were committed at the repo root
# (diag_out.txt, diag_con02*.txt, con02_query.txt) — the first thing visible on
# the GitHub landing page.
diag_*.txt
*.log
*.out

# Backup output — `make backup` writes ./backup by default
backup/
*.ndjson

# RDF exports
exports/

# Node (docs/presentation has a package.json)
node_modules/

# Rebuildable intermediate frames from the silent local evidence walkthrough.
docs/presentation/*_build/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated code knowledge graph — rebuilt with `graphify update .` (pure AST,
# no API key), so committing 11 MB of derived nodes/edges/cache would bloat
# every clone to store something reproducible from the source beside it.
graphify-out/

# Dependency lock is committed — regenerate with: make lock
