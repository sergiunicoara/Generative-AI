@prefix energy: <https://example.energy.demo/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.energy.demo/asset/north-sea-wind-farm> a energy:Site ;
    rdfs:label "North Sea Demonstration Wind Farm" ;
    energy:hasAsset <https://example.energy.demo/asset/WT-01>,
        <https://example.energy.demo/asset/WT-02>,
        <https://example.energy.demo/asset/WT-03>,
        <https://example.energy.demo/asset/WT-04>,
        <https://example.energy.demo/asset/WT-05>,
        <https://example.energy.demo/asset/WT-06>,
        <https://example.energy.demo/asset/WT-07>,
        <https://example.energy.demo/asset/WT-08>,
        <https://example.energy.demo/asset/WT-09>,
        <https://example.energy.demo/asset/WT-10> .

<https://example.energy.demo/document/MFG-GBX-17-R2> a energy:DocumentRevision ;
    prov:wasDerivedFrom <urn:synthetic:sharepoint:technical-guidance> ;
    energy:appliesToComponentType "gearbox" ;
    energy:documentId "MFG-GBX-17-R2" ;
    energy:supersedes <https://example.energy.demo/document/MFG-GBX-17-R1> ;
    energy:temperatureReviewThreshold 85.0 ;
    energy:validFrom "2026-06-01T00:00:00+00:00"^^xsd:dateTime .

<https://example.energy.demo/record/WO-9001> a energy:WorkOrder ;
    prov:wasDerivedFrom <urn:synthetic:sap:work-orders> ;
    energy:concernsAsset <https://example.energy.demo/asset/WT-01> ;
    energy:status "open" ;
    energy:workOrderId "WO-9001" .

<https://example.energy.demo/record/WO-9002> a energy:WorkOrder ;
    prov:wasDerivedFrom <urn:synthetic:sap:work-orders> ;
    energy:concernsAsset <https://example.energy.demo/asset/WT-02> ;
    energy:status "open" ;
    energy:workOrderId "WO-9002" .

<https://example.energy.demo/record/WO-9003> a energy:WorkOrder ;
    prov:wasDerivedFrom <urn:synthetic:sap:work-orders> ;
    energy:concernsAsset <https://example.energy.demo/asset/WT-03> ;
    energy:status "closed" ;
    energy:workOrderId "WO-9003" .

<https://example.energy.demo/record/obs-WT-01-temperature_c> a energy:Observation ;
    prov:wasDerivedFrom <urn:synthetic:snowflake:telemetry> ;
    energy:metric "temperature_c" ;
    energy:observedAsset <https://example.energy.demo/asset/WT-01> ;
    energy:observedAt "2026-08-28T08:00:00+00:00"^^xsd:dateTime ;
    energy:unit "C" ;
    energy:value 96.0 .

<https://example.energy.demo/record/obs-WT-02-vibration_mm_s> a energy:Observation ;
    prov:wasDerivedFrom <urn:synthetic:snowflake:telemetry> ;
    energy:metric "vibration_mm_s" ;
    energy:observedAsset <https://example.energy.demo/asset/WT-02> ;
    energy:observedAt "2026-08-28T08:05:00+00:00"^^xsd:dateTime ;
    energy:unit "mm/s" ;
    energy:value 12.4 .

<https://example.energy.demo/record/obs-WT-03-temperature_c> a energy:Observation ;
    prov:wasDerivedFrom <urn:synthetic:snowflake:telemetry> ;
    energy:metric "temperature_c" ;
    energy:observedAsset <https://example.energy.demo/asset/WT-03> ;
    energy:observedAt "2026-08-28T08:10:00+00:00"^^xsd:dateTime ;
    energy:unit "C" ;
    energy:value 72.0 .

