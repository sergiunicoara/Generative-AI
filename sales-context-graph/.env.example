# Setup, in order — the app returns nothing on :8000 until both are done:
#   1. cp .env.example .env   (this file isn't read directly; .env is)
#   2. docker compose up -d neo4j redis   (or: make up)
#   3. uvicorn api.main:app --port 8000 --reload
# Check readiness with GET /ready — {"status":"ready"} means Neo4j is up and
# reachable; a hung/red response almost always means step 2 didn't finish
# (Neo4j takes ~15-30s to report healthy after container start).

# Host port 7688, not the Neo4j default 7687 — see docker-compose.yml's neo4j
# service comment (this machine already runs another project's Neo4j on 7687).
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=scg_dev_local

# LLM provider. Set LLM_PROVIDER=anthropic plus a key to enable the natural-
# language layer (POST /api/v1/ask). Left blank, LLM-backed routes return 503
# rather than a fabricated answer — everything else in the API works unchanged.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_OUTPUT_TOKENS=2048

# Which ExtractionProvider the API route and the ingestion worker construct.
# "fixture" (default) is the deterministic regex extractor this repo has
# always run in-process: no key, no network, reproducible in tests. "llm"
# selects LlmExtractionProvider, which is also the only path that applies PII
# redaction and the prompt-injection guardrail to window text before it leaves
# the process. Selecting "llm" without LLM_PROVIDER/LLM_API_KEY fails loudly
# (the job is marked failed with a safe message) rather than silently falling
# back to regex extraction and producing quietly worse Claims.
EXTRACTION_PROVIDER=fixture
# Upper bound on simultaneous in-flight extraction calls for one transcript.
# 1 restores strictly sequential behaviour. Bounded so a long transcript's
# window count cannot decide the burst size sent to the LLM vendor.
EXTRACTION_MAX_CONCURRENCY=4

# Optional voice output. The Ask response remains text-first; callers invoke
# POST /api/v1/tts only when the user enables audio. Keep the key server-side.
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_BASE_URL=https://api.openai.com/v1
TTS_TIMEOUT_SECONDS=2

# Embedding provider. Two independent consumers:
# 1. src/resolution/scoring.py's semantic-similarity term in entity
#    resolution (§8) -- always uses the local, offline
#    SentenceTransformerEmbeddingProvider regardless of this setting.
# 2. Phase 7 (docs/evaluation.md's B5 item) -- src/embedding/backfill.py's
#    contact_embeddings_v1 population, via
#    src/embedding/openai_embedding_provider.py. EMBEDDING_API_KEY is
#    required for this path; left blank, the backfill script fails closed
#    (EmbeddingNotConfiguredError) rather than writing a fabricated vector.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# Context Graph reranker (Phase 7) -- off by default, see
# src/context_graph/reranker.py. Local cross-encoder, no API key needed;
# only meaningful when a caller also supplies ContextGraphScope.query_text.
RERANKER_ENABLED=false

# API key per workspace (MVP auth, see api/dependencies.py::verify_api_key) —
# JSON map of workspace_id -> secret key. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKSPACE_API_KEYS={"ws-demo":"replace-with-a-generated-secret"}

# Temporary public preview for the Cloudflare demo tunnel. Keep false by
# default; never enable in production. The preview key is separate from the
# real workspace key, scoped to DEMO_PUBLIC_WORKSPACE_ID, and read-only.
# DEMO_PUBLIC_ACCESS_ENABLED=false
# DEMO_PUBLIC_WORKSPACE_ID=ws-demo
# DEMO_PUBLIC_API_KEY=generate-a-short-lived-demo-key
# DEMO_PUBLIC_TTS_ENABLED=false

# Optional deny-by-default resource authorization. Enable only with a real
# OIDC/SSO claim path or an ingress that validates and overwrites the actor
# headers; otherwise the API fails closed with 503.
AUTHZ_ENFORCEMENT_ENABLED=false
AUTHZ_TRUSTED_GATEWAY_ENABLED=false
# Required only when ENV=production and AUTHZ_ENFORCEMENT_ENABLED=false:
# production must state the choice rather than inherit it from a default.
# AUTHZ_ENFORCEMENT_DISABLED_ACK=true

# OIDC/JWT SSO. When SSO_ENABLED=true, all standard API routes authenticate
# `Authorization: Bearer <JWT>` through this verifier instead of X-Api-Key.
# The issuer must expose an RS256 JWKS endpoint and include the configured
# workspace claim. Keep disabled until these real IdP values are available.
SSO_ENABLED=false
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URL=
SSO_WORKSPACE_CLAIM=workspace_id

# Optional authenticated Streamable-HTTP MCP surface. Each request uses
# Authorization: Bearer <workspace API key> plus X-Workspace-Id (or a JWT when
# SSO is enabled). Local API-key callers receive read/recommend tools; verified
# approver roles are required for CRM writes.
MCP_ENABLED=false
MCP_REQUEST_MAX_BYTES=65536
LOCAL_CRM_EMULATOR_PATH=data/runtime/local_crm_emulator.json

# Redis — durable ingestion job store (local: docker-compose's redis service;
# Fly.io: `fly redis create`, an Upstash-backed managed Redis). Leave unset to
# fall back to the in-memory store (api/state.py's InMemoryIngestionStore).
REDIS_URL=redis://localhost:6380/0
INGESTION_QUEUE_ENABLED=false
INGESTION_QUEUE_MAX_ATTEMPTS=3
INGESTION_WORKER_HEARTBEAT_SECONDS=60
INGESTION_WORKER_CONCURRENCY=1
# SQS-style visibility timeout (ADR-0001's addendum) — how long a claimed
# job may sit unfinished in a worker's processing list before the reaper
# assumes that worker crashed and puts the job back on the main queue.
INGESTION_VISIBILITY_TIMEOUT_SECONDS=300

# Proactive digest delivery (Increment 17). GET /api/v1/digest always works;
# POST /api/v1/digest/deliver returns 503 until SLACK_WEBHOOK_URL is set. No
# in-process scheduler exists (see docs/operations.md) — call /deliver from an
# external cron (Fly scheduled machine, GitHub Actions, etc).
SLACK_WEBHOOK_URL=
DIGEST_STALE_SHARE_DAYS=7
DIGEST_STALLED_DEAL_DAYS=21

# Exact-match query-result cache (Phase 5, docs/evaluation.md's semantic/
# result-cache item — see src/core/cache/query_cache.py). No-op wherever
# REDIS_URL is unset.
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=300

# PII redaction at LLM-prompt/log egress (Phase 6, see src/redaction/pii.py
# and docs/security-and-tenancy.md's "PII handling" section). Raw text stays
# verbatim at rest; this only gates the two egress points.
PII_REDACTION_ENABLED=true

# Prompt-injection guardrail (Phase 6, ADR-0002) — additive to the existing
# structural defenses, log_only by default: flags and metrics a suspected
# injection attempt but never blocks extraction. "block" is implemented but
# not recommended without reviewing real flagged-window data first.
GUARDRAIL_ENFORCEMENT_MODE=log_only

# Embeddable panel (Increment 20, GET /viz/panel) — space-separated list of
# origins allowed to iframe it (sets Content-Security-Policy: frame-ancestors).
# Empty means no origin may embed it; the panel still works opened directly.
EMBED_ALLOWED_ORIGINS=

# HMAC secret for the panel token that replaced putting the real workspace
# API key in /viz/panel's URL (docs/evaluation.md's Showpad-compatibility
# analysis, item 3; see src/viz/panel_tokens.py). Required — POST
# /viz/panel-token and GET /viz/panel both return 503 without it. Requires
# REDIS_URL too (revocation-version store).
PANEL_TOKEN_SECRET=
# Panel token lifetime in seconds. Deliberately long by default (~1 year) —
# the panel is a static, admin-configured iframe src with no refresh flow;
# revoke early via a version bump instead of a short TTL.
PANEL_TOKEN_TTL_SECONDS=31536000

# Deployment environment — "production" enables src/core/config.py's
# insecure-default checks (neo4j password, workspace_api_keys presence).
ENV=development
LOG_LEVEL=INFO
# Production must set this. When non-empty, /metrics requires
# Authorization: Bearer <METRICS_API_KEY>.
METRICS_API_KEY=

# Used only for `docker compose --profile observability up`. The Compose
# default is local-only; set a unique value before exposing Grafana anywhere.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
